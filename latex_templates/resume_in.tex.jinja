\#{ ------------------------------------------------------------------------------------------ }
\#{ Indian-market resume layout, converted from the owner's own .tex.                           }
\#{ Based on Jake Gutierrez's template, itself based on https://github.com/sb2nov/resume, MIT.   }
\#{                                                                                              }
\#{ NOTE: a Jinja comment here runs from the opening delimiter to the very next closing brace, so }
\#{ no comment line in this file may contain a brace of either kind. One inside a comment ends it }
\#{ early and dumps the rest of the prose into the document before the documentclass line, which  }
\#{ surfaces as the baffling "LaTeX Error: Missing begin document".                               }
\#{                                                                                              }
\#{ Three deliberate departures from the source .tex, each one required to compile under          }
\#{ Tectonic, which is a XeTeX engine rather than pdfTeX:                                         }
\#{                                                                                              }
\#{  * fontawesome5 is NOT loaded. Loading it makes Tectonic die with a heap-corruption crash     }
\#{    while pulling FontAwesome5Free-Solid-900.otf through its XeTeX helper. The source .tex     }
\#{    never actually placed an icon anyway -- the stray raisebox fragments in the contact line   }
\#{    are leftovers from where icons used to be -- so nothing visible is lost.                   }
\#{  * marvosym is NOT loaded either. Also unused, and it is another font-heavy package.          }
\#{  * The glyphtounicode input and pdfgentounicode assignment are guarded behind ifdefined.      }
\#{    Both are pdfTeX primitives that XeTeX does not provide, so unguarded they fail with        }
\#{    "Undefined control sequence" inside glyphtounicode.tex. They exist to make the PDF's text  }
\#{    layer ATS-parsable; XeTeX already emits sane Unicode mappings, and the guard means they    }
\#{    switch themselves back on if this is ever compiled with pdfTeX.                            }
\#{                                                                                               }
\#{ Contract rules, same as resume.tex.jinja:                                                     }
\#{  1. No photograph. app/latex_render.py declares this layout with supports_photo=False, so     }
\#{     has_photo is always False here and the photo bytes are never even fetched.                }
\#{  2. Escaping is split. name, summary and every per-entry field go through latex_escape HERE.  }
\#{     But header_location, header_line2, header_linkedin, header_website and languages_line are }
\#{     emitted RAW -- _build_header_fields in app/latex_render.py already escaped them and built }
\#{     the hyperlink markup. Escaping those twice prints backslashes; forgetting to escape the   }
\#{     others lets a stray ampersand or percent sign in a resume break the build.                }
\#{  3. latex_templates/prewarm_in.tex mirrors this preamble and is compiled during the Docker    }
\#{     build so Tectonic's bundle cache is warm. Add a package here, add it there too, or the    }
\#{     first compile in production pays a download and fails outright if egress is blocked.      }
\#{ ------------------------------------------------------------------------------------------ }
\documentclass[letterpaper,11pt]{article}

\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage[usenames,dvipsnames]{color}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{tabularx}
\usepackage{multicol}
\usepackage{setspace}

\renewcommand{\baselinestretch}{1.5}
\setlength{\multicolsep}{-3.0pt}
\setlength{\columnsep}{-1pt}

\#{ pdfTeX-only; see the header note. Silently skipped under Tectonic/XeTeX. }
\ifdefined\pdfgentounicode
  \input{glyphtounicode}
\fi

\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\addtolength{\oddsidemargin}{-0.6in}
\addtolength{\evensidemargin}{-0.5in}
\addtolength{\textwidth}{1.19in}
\addtolength{\topmargin}{-.7in}
\addtolength{\textheight}{1.4in}

\urlstyle{same}

\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

\titleformat{\section}{
  \vspace{-4pt}\scshape\raggedright\large\bfseries
}{}{0em}{}[\color{black}\titlerule \vspace{-5pt}]

\ifdefined\pdfgentounicode
  \pdfgentounicode=1
\fi

\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{1.0\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & \textbf{\small #2} \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{1.010\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & \textbf{\small #2}\\
    \end{tabular*}\vspace{-7pt}
}

\renewcommand\labelitemi{$\vcenter{\hbox{\tiny$\bullet$}}$}
\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.0in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}[leftmargin=0.2in]}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

\begin{document}

\#{ ----------HEADING---------- }
\begin{center}
    {\huge \scshape \VAR{name | latex_escape}} \\ \vspace{2pt}
\BLOCK{ if header_location }
    \VAR{header_location} \\ \vspace{1pt}
\BLOCK{ endif }
    \small \VAR{header_line2}\BLOCK{ if header_linkedin } {|} \underline{\VAR{header_linkedin}}\BLOCK{ endif }\BLOCK{ if header_website } {|} \underline{\VAR{header_website}}\BLOCK{ endif }
    \vspace{-5pt}
\end{center}

\BLOCK{ if summary }
\section{Summary}
\VAR{summary | latex_escape}
\BLOCK{ endif }

\#{ -----------EDUCATION----------- }
\BLOCK{ if education }
\section{Education}
\resumeSubHeadingListStart
\BLOCK{ for entry in education }
    \resumeSubheading
      {\VAR{entry.institution | latex_escape}}{\VAR{entry.dates | latex_escape}}
      {\VAR{entry.degree | latex_escape}}{\VAR{entry.location | latex_escape}}
\BLOCK{ endfor }
\resumeSubHeadingListEnd
\vspace{-15pt}
\BLOCK{ endif }

\#{ -----------TECHNICAL SKILLS----------- }
\BLOCK{ if skill_categories or languages_line }
\section{Professional Skills}
 \begin{itemize}[leftmargin=0.0in, label={}]
    \small{\item{
\BLOCK{ for cat in skill_categories }
     \textbf{\VAR{cat.category | latex_escape}}{: \VAR{cat['items'] | join(', ') | latex_escape}} \\
     \vspace{4pt}
\BLOCK{ endfor }
\BLOCK{ if languages_line }
    \textbf{Spoken Languages}: \VAR{languages_line}
\BLOCK{ endif }
     }}
 \end{itemize}
 \vspace{-15pt}
\BLOCK{ endif }

\#{ -----------EXPERIENCE----------- }
\BLOCK{ if experience }
\section{Professional Experience}
  \resumeSubHeadingListStart
\BLOCK{ for entry in experience }
   \resumeSubheading
      {\VAR{entry.organization | latex_escape}}{\VAR{entry.dates | latex_escape}}
      {\VAR{entry.title | latex_escape}\BLOCK{ if entry.technologies } $|$ {\VAR{entry.technologies | join(', ') | latex_escape}}\BLOCK{ endif }}{\VAR{entry.location | latex_escape}}
\BLOCK{ if entry.bullets }
      \resumeItemListStart
\BLOCK{ for bullet in entry.bullets }
        \resumeItem{\VAR{bullet | latex_escape}}
\BLOCK{ endfor }
      \resumeItemListEnd
\BLOCK{ endif }
\BLOCK{ endfor }
  \resumeSubHeadingListEnd
\vspace{-13pt}
\BLOCK{ endif }

\#{ -----------PROJECTS----------- }
\BLOCK{ if projects }
\section{Projects}
    \vspace{-5pt}
    \resumeSubHeadingListStart
\BLOCK{ for entry in projects }
      \resumeProjectHeading
          {\textbf{\VAR{entry.name | latex_escape}}\BLOCK{ if entry.link } $|$ \href{\VAR{entry.link}}{\underline{\VAR{entry.link | latex_escape}}}\BLOCK{ endif }\BLOCK{ if entry.technologies } \\ \emph{\VAR{entry.technologies | join(', ') | latex_escape}}\BLOCK{ endif }}{\VAR{entry.dates | latex_escape}}
\BLOCK{ if entry.bullets }
          \resumeItemListStart
\BLOCK{ for bullet in entry.bullets }
            \resumeItem{\VAR{bullet | latex_escape}}
\BLOCK{ endfor }
          \resumeItemListEnd
\BLOCK{ endif }
\BLOCK{ if not loop.last }
          \vspace{-20pt}
\BLOCK{ endif }
\BLOCK{ endfor }
    \resumeSubHeadingListEnd
\BLOCK{ endif }

\end{document}
