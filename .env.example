# Get a free key (no credit card required) at https://aistudio.google.com
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash

# Path/command for the Tectonic LaTeX binary (just "tectonic" if it's on PATH,
# e.g. inside the Docker image; a full path is useful for local Windows dev)
TECTONIC_BIN=tectonic

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PHOTO_BUCKET=photo
PDF_BUCKET=resume-pdf

# Sliding-window rate limit protecting the shared Gemini free-tier quota: at most
# GENERATION_LIMIT generations in any rolling GENERATION_WINDOW_HOURS. Sliding rather than
# per-calendar-day so there's no burst straddling a bucket boundary.
GENERATION_LIMIT=5
GENERATION_WINDOW_HOURS=5
