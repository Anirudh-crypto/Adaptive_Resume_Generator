[
  {
    "name": "keep-recent",
    "action": { "type": "Keep" },
    "mostRecentVersions": {
      "packageNamePrefixes": ["app"],
      "keepCount": 3
    }
  },
  {
    "name": "delete-stale",
    "action": { "type": "Delete" },
    "condition": {
      "tagState": "ANY",
      "olderThan": "21d"
    }
  }
]
